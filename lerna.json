{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.2.0",
  "npmClient": "npm",
  "command": {
    "publish": {
      "message": "chore(release): publish %s",
      "conventionalCommits": true,
      "yes": false
    },
    "version": {
      "conventionalCommits": true,
      "message": "chore(release): %s"
    }
  },
  "ignoreChanges": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.md",
    "**/demos/**"
  ]
}