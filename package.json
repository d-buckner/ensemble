{
  "name": "ensemble-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "demos/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "node scripts/test-summary.js",
    "test:raw": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "demo:react:counter": "turbo run dev --filter=demo-react-counter",
    "demo:solidjs:counter": "turbo run dev --filter=demo-solidjs-counter",
    "demo:solidjs:metrics-dashboard": "turbo run dev --filter=demo-solidjs-metrics-dashboard"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
