{
  "name": "ensemble-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "demos/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test:summary": "node scripts/test-summary.js",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "turbo run dev",
    "demo:react:counter": "turbo run dev --filter=demo-react-counter",
    "demo:solidjs:counter": "turbo run dev --filter=demo-solidjs-counter",
    "demo:solidjs:metrics-dashboard": "turbo run dev --filter=demo-solidjs-metrics-dashboard",
    "version": "lerna version --no-private",
    "publish": "lerna publish from-package --no-private",
    "publish:ci": "lerna publish from-package --no-private --yes"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "lerna": "^9.0.0",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.46.0"
  }
}
