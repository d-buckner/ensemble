  },
  "dependencies": {
    "@d-buckner/ensemble-core": "*"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.1",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^27.0.0",
    "solid-js": "^1.9.3",
    "typescript": "~5.9.3",
    "vite-plugin-solid": "^2.11.9",
    "vitest": "^3.2.4"
  }
