{
  "name": "@d-buckner/ensemble-collaboration",
  "version": "0.1.0",
  "description": "Collaboration CRDT package for Ensemble actor framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:server": "npx tsx examples/standalone-server.ts",
    "demo:client": "cd ../../demos/react/collaboration && npm run dev",
    "demo": "npm run build && npx concurrently -n server,client -c blue,green \"npm run demo:server\" \"npm run demo:client\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-buckner/ensemble.git",
    "directory": "packages/collaboration"
  },
  "keywords": [
    "actor",
    "collaboration",
    "crdt",
    "automerge",
    "realtime",
    "webrtc",
    "websocket"
  ],
  "author": "Daniel Buckner",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@automerge/automerge": "^2.2.8",
    "mutative": "^1.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.7.0"
  },
  "peerDependencies": {
    "@d-buckner/ensemble-core": "^0.1.0",
    "simple-peer": "^9.11.0"
  },
  "devDependencies": {
    "@d-buckner/ensemble-core": "*",
    "@d-buckner/ensemble-vite-plugin": "*",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
