    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "immer": "^10.1.3",
    "msgpackr": "^1.11.5",
    "reflect-metadata": "^0.2.2"
