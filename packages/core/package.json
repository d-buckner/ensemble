{
  "name": "@d-buckner/ensemble-core",
  "version": "0.2.0",
  "description": "Type-safe actor model framework for predictable state management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/threading/worker-entry.d.ts",
      "default": "./dist/threading/worker-entry.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-buckner/ensemble.git",
    "directory": "packages/core"
  },
  "keywords": [
    "actor",
    "actor-model",
    "state-management",
    "typescript",
    "reactive",
    "effects",
    "dependency-injection",
    "threading",
    "web-workers"
  ],
  "author": "Daniel Buckner",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "msgpackr": "^1.11.5",
    "mutative": "^1.3.0"
  }
}
