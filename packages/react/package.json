  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "@d-buckner/ensemble-core": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
